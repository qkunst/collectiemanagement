<h1><%= I18n.t("application.name") %></h1>
<p>Welkom in de <%= I18n.t("application.name") %> webapplicatie. Indien u bent geautoriseerd kunt u inloggen om toegang te krijgen tot de collectie van uw organisatie.  </p>
<% if @methods.include? :google_oauth2 %>
<%= button_to "Log in met uw Google account", omniauth_authorize_path(:user, :google_oauth2, provider_uuid: @auth_provider_uuid), class: [:secondary, :button], data: {turbo: false} %><br>
<% end %>
<% if @methods.include? :azureactivedirectory %>
<%= button_to "Log in met uw Microsoft account", omniauth_authorize_path(:user, :azureactivedirectory, provider_uuid: @auth_provider_uuid), class: [:secondary, :button], data: {turbo: false} %><br>
<% end %>
<% if @methods.include? :central_login %>
<%= button_to "Log in met Central Login", omniauth_authorize_path(:user, :central_login, provider_uuid: @auth_provider_uuid), class: [:secondary, :button], data: {turbo: false} %><br>
<% end %>
